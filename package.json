{
  "name": "estoque",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "description": "API para gestão de controle de estoque. Backend em Node.js com Express e Swagger.",
  "main": "src/index.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "install-all": "npm install",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RamonCimol/estoque.git"
  },
  "keywords": [
    "estoque",
    "api",
    "nodejs",
    "express",
    "swagger"
  ],
  "author": "Alisson,Eliseu, Ramon",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RamonCimol/estoque/issues"
  },
  "homepage": "https://github.com/RamonCimol/estoque#readme",
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2"
  }
}
